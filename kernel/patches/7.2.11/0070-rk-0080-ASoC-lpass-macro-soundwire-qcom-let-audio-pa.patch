From: duolinux kernel port <port@localhost>
Date: Sat, 31 Oct 2026 10:59:04 -0600
Subject: [PATCH 70/79] rk:
 0080-ASoC-lpass-macro-soundwire-qcom-let-audio-path-power-down.patch

---
 drivers/soundwire/qcom.c           | 17 +++++++++++++++
 sound/soc/codecs/lpass-rx-macro.c  | 30 ++++++++++++++++++++++++++-
 sound/soc/codecs/lpass-tx-macro.c  | 30 ++++++++++++++++++++++++++-
 sound/soc/codecs/lpass-va-macro.c  | 33 ++++++++++++++++++++++++++++--
 sound/soc/codecs/lpass-wsa-macro.c | 22 +++++++++++++++++++-
 5 files changed, 127 insertions(+), 5 deletions(-)

diff --git a/drivers/soundwire/qcom.c b/drivers/soundwire/qcom.c
index b288218f6..ac14b0bcc 100644
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -1807,7 +1807,24 @@ static int __maybe_unused swrm_runtime_suspend(struct device *dev)
 	return 0;
 }
 
+static int __maybe_unused swrm_suspend(struct device *dev)
+{
+	if (pm_runtime_status_suspended(dev))
+		return 0;
+
+	return swrm_runtime_suspend(dev);
+}
+
+static int __maybe_unused swrm_resume(struct device *dev)
+{
+	if (pm_runtime_status_suspended(dev))
+		return 0;
+
+	return swrm_runtime_resume(dev);
+}
+
 static const struct dev_pm_ops swrm_dev_pm_ops = {
+	SET_SYSTEM_SLEEP_PM_OPS(swrm_suspend, swrm_resume)
 	SET_RUNTIME_PM_OPS(swrm_runtime_suspend, swrm_runtime_resume, NULL)
 };
 
diff --git a/sound/soc/codecs/lpass-rx-macro.c b/sound/soc/codecs/lpass-rx-macro.c
index 6233aa9f5..083f5c12a 100644
--- a/sound/soc/codecs/lpass-rx-macro.c
+++ b/sound/soc/codecs/lpass-rx-macro.c
@@ -3671,9 +3671,14 @@ static int swclk_gate_enable(struct clk_hw *hw)
 	struct rx_macro *rx = to_rx_macro(hw);
 	int ret;
 
+	ret = pm_runtime_resume_and_get(rx->dev);
+	if (ret < 0)
+		return ret;
+
 	ret = clk_prepare_enable(rx->mclk);
 	if (ret) {
 		dev_err(rx->dev, "unable to prepare mclk\n");
+		pm_runtime_put_autosuspend(rx->dev);
 		return ret;
 	}
 
@@ -3694,6 +3699,9 @@ static void swclk_gate_disable(struct clk_hw *hw)
 
 	rx_macro_mclk_enable(rx, false);
 	clk_disable_unprepare(rx->mclk);
+
+	pm_runtime_mark_last_busy(rx->dev);
+	pm_runtime_put_autosuspend(rx->dev);
 }
 
 static int swclk_gate_is_enabled(struct clk_hw *hw)
@@ -3907,7 +3915,7 @@ static int rx_macro_probe(struct platform_device *pdev)
 
 	pm_runtime_set_autosuspend_delay(dev, 3000);
 	pm_runtime_use_autosuspend(dev);
-	pm_runtime_mark_last_busy(dev);
+	pm_runtime_get_noresume(dev);
 	pm_runtime_set_active(dev);
 	pm_runtime_enable(dev);
 
@@ -3915,6 +3923,9 @@ static int rx_macro_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_clkout;
 
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_put_autosuspend(dev);
+
 	return 0;
 
 err_clkout:
@@ -4014,7 +4025,24 @@ static int rx_macro_runtime_resume(struct device *dev)
 	return ret;
 }
 
+static int rx_macro_suspend(struct device *dev)
+{
+	if (pm_runtime_status_suspended(dev))
+		return 0;
+
+	return rx_macro_runtime_suspend(dev);
+}
+
+static int rx_macro_resume(struct device *dev)
+{
+	if (pm_runtime_status_suspended(dev))
+		return 0;
+
+	return rx_macro_runtime_resume(dev);
+}
+
 static const struct dev_pm_ops rx_macro_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(rx_macro_suspend, rx_macro_resume)
 	RUNTIME_PM_OPS(rx_macro_runtime_suspend, rx_macro_runtime_resume, NULL)
 };
 
