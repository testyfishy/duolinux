From 100a6dae4f3fd10868b714e9e32fce2f71a920a9 Mon Sep 17 00:00:00 2001
From: duolinux kernel port <port@localhost>
Date: Sat, 31 Oct 2026 10:58:56 -0600
Subject: [PATCH 48/79] rk:
 0058-fusb302-trigger-tx-via-tx-start-bit-not-txon-token.patch

---
 drivers/usb/typec/tcpm/fusb302.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/typec/tcpm/fusb302.c b/drivers/usb/typec/tcpm/fusb302.c
index b575c6c2e..a7bce495a 100644
--- a/drivers/usb/typec/tcpm/fusb302.c
+++ b/drivers/usb/typec/tcpm/fusb302.c
@@ -998,12 +998,16 @@ static int fusb302_pd_send_message(struct fusb302_chip *chip,
 	buf[pos++] = FUSB302_TKN_EOP;
 	/* turn tx off after sending message */
 	buf[pos++] = FUSB302_TKN_TXOFF;
-	/* start transmission */
-	buf[pos++] = FUSB302_TKN_TXON;
 
 	ret = fusb302_i2c_block_write(chip, FUSB_REG_FIFOS, pos, buf);
 	if (ret < 0)
 		return ret;
+
+	ret = fusb302_i2c_set_bits(chip, FUSB_REG_CONTROL0,
+				   FUSB_REG_CONTROL0_TX_START);
+	if (ret < 0)
+		return ret;
+
 	fusb302_log(chip, "sending PD message header: %x", msg->header);
 	fusb302_log(chip, "sending PD message len: %d", len);
 
-- 
