From deced7b8c5e3f17863ef69cb5bb3fc02bb3c94b7 Mon Sep 17 00:00:00 2001
From: duolinux kernel port <port@localhost>
Date: Sat, 31 Oct 2026 10:58:54 -0600
Subject: [PATCH 40/79] rk: 0047-backlight-pwm_bl-add-brightness-scale.patch

---
 drivers/video/backlight/pwm_bl.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/video/backlight/pwm_bl.c b/drivers/video/backlight/pwm_bl.c
index 237d3d3f3..8e9982107 100644
--- a/drivers/video/backlight/pwm_bl.c
+++ b/drivers/video/backlight/pwm_bl.c
@@ -446,6 +446,7 @@ static int pwm_backlight_probe(struct platform_device *pdev)
 	struct pwm_bl_data *pb;
 	struct pwm_state state;
 	unsigned int i;
+	u32 scale;
 	int ret;
 
 	if (!data) {
@@ -539,6 +540,10 @@ static int pwm_backlight_probe(struct platform_device *pdev)
 			if (data->levels[i] > pb->scale)
 				pb->scale = data->levels[i];
 
+		if (!device_property_read_u32(&pdev->dev, "brightness-scale", &scale) &&
+		    scale > pb->scale)
+			pb->scale = scale;
+
 		if (pwm_backlight_is_linear(data))
 			props.scale = BACKLIGHT_SCALE_LINEAR;
 		else
