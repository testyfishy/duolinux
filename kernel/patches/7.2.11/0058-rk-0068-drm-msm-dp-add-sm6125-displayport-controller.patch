From 6e3d0311b8d2a8e2291c83cab0a0a346f01d3ad4 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@gmail.com>
Date: Tue, 29 Sep 2026 22:00:00 -0500
Subject: rk:
 0068-drm-msm-dp-add-sm6125-displayport-controller.patch

---
 drivers/gpu/drm/msm/dp/dp_display.c | 28 +++++++++++++++++++++++++---
 drivers/gpu/drm/msm/dp/dp_drm.c     |  4 ++++
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 22eade11c..0b3895405 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -112,6 +112,11 @@ static const struct msm_dp_desc msm_dp_desc_sa8775p[] = {
 	{}
 };
 
+static const struct msm_dp_desc msm_dp_desc_sm6125[] = {
+	{ .io_start = 0x05e90000, .id = MSM_DP_CONTROLLER_0 },
+	{}
+};
+
 static const struct msm_dp_desc msm_dp_desc_sdm845[] = {
 	{ .io_start = 0x0ae90000, .id = MSM_DP_CONTROLLER_0 },
 	{}
@@ -171,6 +176,7 @@ static const struct of_device_id msm_dp_dt_match[] = {
 	{ .compatible = "qcom,sc8280xp-dp", .data = &msm_dp_desc_sc8280xp },
 	{ .compatible = "qcom,sc8280xp-edp", .data = &msm_dp_desc_sc8280xp },
 	{ .compatible = "qcom,sdm845-dp", .data = &msm_dp_desc_sdm845 },
+	{ .compatible = "qcom,sm6125-dp", .data = &msm_dp_desc_sm6125 },
 	{ .compatible = "qcom,sm8350-dp", .data = &msm_dp_desc_sc7180 },
 	{ .compatible = "qcom,sm8650-dp", .data = &msm_dp_desc_sm8650 },
 	{ .compatible = "qcom,x1e80100-dp", .data = &msm_dp_desc_x1e80100 },
@@ -688,6 +694,17 @@ static int msm_dp_display_disable(struct msm_dp_display_private *dp)
  * @mode: Pointer to drm mode structure
  * Returns: Validity status for specified mode
  */
+/*
+ * A downstream bridge that supplies its own modes is a hardwired sink
+ * without hotplug: the link is brought up and down from the bridge
+ * enable and disable paths, like eDP.
+ */
+static bool msm_dp_display_fixed_sink(struct msm_dp_display_private *dp)
+{
+	return dp->msm_dp_display.next_bridge &&
+	       (dp->msm_dp_display.next_bridge->ops & DRM_BRIDGE_OP_MODES);
+}
+
 enum drm_mode_status msm_dp_bridge_mode_valid(struct drm_bridge *bridge,
 					  const struct drm_display_info *info,
 					  const struct drm_display_mode *mode)
@@ -738,7 +755,8 @@ enum drm_mode_status msm_dp_bridge_mode_valid(struct drm_bridge *bridge,
 	mode_rate_khz = link_pclk_khz * mode_bpp;
 	supported_rate_khz = link_info->num_lanes * link_info->rate * 8;
 
-	if (mode_rate_khz > supported_rate_khz)
+	/* A fixed sink is validated before its capabilities are read */
+	if (supported_rate_khz && mode_rate_khz > supported_rate_khz)
 		return MODE_BAD;
 
 	return MODE_OK;
@@ -1366,7 +1384,7 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 		return;
 	}
 
-	if (dp->is_edp)
+	if (dp->is_edp || msm_dp_display_fixed_sink(msm_dp_display))
 		msm_dp_hpd_plug_handle(msm_dp_display);
 
 	if (pm_runtime_resume_and_get(&dp->pdev->dev)) {
@@ -1441,7 +1459,7 @@ void msm_dp_bridge_atomic_post_disable(struct drm_bridge *drm_bridge,
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
 
-	if (dp->is_edp)
+	if (dp->is_edp || msm_dp_display_fixed_sink(msm_dp_display))
 		msm_dp_hpd_unplug_handle(msm_dp_display);
 
 	msm_dp_display_disable(msm_dp_display);
@@ -1534,6 +1552,10 @@ void msm_dp_bridge_hpd_notify(struct drm_bridge *bridge,
 	struct msm_dp_display_private *dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
 	u32 hpd_link_status = 0;
 
+	/* A fixed sink is plugged from the bridge enable path instead */
+	if (msm_dp_display_fixed_sink(dp))
+		return;
+
 	if (pm_runtime_resume_and_get(&msm_dp_display->pdev->dev)) {
 		DRM_ERROR("failed to pm_runtime_resume\n");
 		return;
diff --git a/drivers/gpu/drm/msm/dp/dp_drm.c b/drivers/gpu/drm/msm/dp/dp_drm.c
index b659d22f5..ccc26e33f 100644
--- a/drivers/gpu/drm/msm/dp/dp_drm.c
+++ b/drivers/gpu/drm/msm/dp/dp_drm.c
@@ -322,6 +322,10 @@ struct drm_connector *msm_dp_drm_connector_init(struct msm_dp *msm_dp_display,
 	if (IS_ERR(connector))
 		return connector;
 
+	if (msm_dp_display->next_bridge &&
+	    (msm_dp_display->next_bridge->ops & DRM_BRIDGE_OP_MODES))
+		connector->force = DRM_FORCE_OFF;
+
 	if (!msm_dp_display->is_edp)
 		drm_connector_attach_dp_subconnector_property(connector);
 
-- 
2.53.0

