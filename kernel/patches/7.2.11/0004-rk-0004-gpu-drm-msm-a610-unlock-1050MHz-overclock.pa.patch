From feb85ea52f92f7699657053dbd9e7407bd42be22 Mon Sep 17 00:00:00 2001
From: Philippe Simons <simons.philippe@gmail.com>
Date: Sat, 27 Dec 2025 20:49:13 +0100
Subject: rk:
 0004-gpu-drm-msm-a610-unlock-1050MHz-overclock.patch

---
 arch/arm64/boot/dts/qcom/sm6115.dtsi      | 24 ++++++++++++++++-------
 drivers/clk/qcom/gpucc-sm6115.c           |  3 ++-
 drivers/gpu/drm/msm/adreno/a6xx_catalog.c |  3 ++-
 drivers/pmdomain/qcom/rpmpd.c             |  2 +-
 4 files changed, 22 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6115.dtsi b/arch/arm64/boot/dts/qcom/sm6115.dtsi
index bd94eb87d..f989d11cd 100644
--- a/arch/arm64/boot/dts/qcom/sm6115.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6115.dtsi
@@ -429,6 +429,10 @@ rpmpd_opp_turbo: opp7 {
 						rpmpd_opp_turbo_plus: opp8 {
 							opp-level = <RPM_SMD_LEVEL_TURBO_NO_CPR>;
 						};
+
+						rpmpd_opp_turbo_high: opp9 {
+							opp-level = <464>;
+						};
 					};
 				};
 			};
@@ -1759,37 +1763,37 @@ gpu_opp_table: opp-table {
 				opp-320000000 {
 					opp-hz = /bits/ 64 <320000000>;
 					required-opps = <&rpmpd_opp_low_svs>;
-					opp-supported-hw = <0x1f>;
+					opp-supported-hw = <0x3f>;
 				};
 
 				opp-465000000 {
 					opp-hz = /bits/ 64 <465000000>;
 					required-opps = <&rpmpd_opp_svs>;
-					opp-supported-hw = <0x1f>;
+					opp-supported-hw = <0x3f>;
 				};
 
 				opp-600000000 {
 					opp-hz = /bits/ 64 <600000000>;
 					required-opps = <&rpmpd_opp_svs_plus>;
-					opp-supported-hw = <0x1f>;
+					opp-supported-hw = <0x3f>;
 				};
 
 				opp-745000000 {
 					opp-hz = /bits/ 64 <745000000>;
 					required-opps = <&rpmpd_opp_nom>;
-					opp-supported-hw = <0xf>;
+					opp-supported-hw = <0x2f>;
 				};
 
 				opp-820000000 {
 					opp-hz = /bits/ 64 <820000000>;
 					required-opps = <&rpmpd_opp_nom_plus>;
-					opp-supported-hw = <0x7>;
+					opp-supported-hw = <0x27>;
 				};
 
 				opp-900000000 {
 					opp-hz = /bits/ 64 <900000000>;
 					required-opps = <&rpmpd_opp_turbo>;
-					opp-supported-hw = <0x7>;
+					opp-supported-hw = <0x27>;
 				};
 
 				/* Speed bin 2 can reach 950 Mhz instead of 980 like the rest. */
@@ -1802,8 +1806,14 @@ opp-950000000 {
 				opp-980000000 {
 					opp-hz = /bits/ 64 <980000000>;
 					required-opps = <&rpmpd_opp_turbo_plus>;
-					opp-supported-hw = <0x3>;
+					opp-supported-hw = <0x23>;
 				};
+
+				opp-1050000000 {
+					opp-hz = /bits/ 64 <1050000000>;
+					required-opps = <&rpmpd_opp_turbo_high>;
+					opp-supported-hw = <0x20>;
+				};				
 			};
 		};
 
diff --git a/drivers/clk/qcom/gpucc-sm6115.c b/drivers/clk/qcom/gpucc-sm6115.c
index a075fa395..08f2635b0 100644
--- a/drivers/clk/qcom/gpucc-sm6115.c
+++ b/drivers/clk/qcom/gpucc-sm6115.c
@@ -38,7 +38,7 @@ enum {
 };
 
 static const struct pll_vco default_vco[] = {
-	{ 1000000000, 2000000000, 0 },
+	{ 1000000000, 2100000000, 0 },
 };
 
 static const struct pll_vco pll1_vco[] = {
@@ -215,6 +215,7 @@ static const struct freq_tbl ftbl_gpu_cc_gx_gfx3d_clk_src[] = {
 	F(900000000, P_GPU_CC_PLL0_OUT_AUX2, 2, 0, 0),
 	F(950000000, P_GPU_CC_PLL0_OUT_AUX2, 2, 0, 0),
 	F(980000000, P_GPU_CC_PLL0_OUT_AUX2, 2, 0, 0),
+	F(1050000000, P_GPU_CC_PLL0_OUT_AUX2, 2, 0, 0),
 	{ }
 };
 
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
index a98d550b7..2f3ee7ede 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
@@ -706,11 +706,12 @@ static const struct adreno_info a6xx_gpus[] = {
 		 * table is only valid for bengal.
 		 */
 		.speedbins = ADRENO_SPEEDBINS(
-			{ 0,   0 },
+			{ 0,   5 },
 			{ 206, 1 },
 			{ 200, 2 },
 			{ 157, 3 },
 			{ 127, 4 },
+			{ 221, 5 },
 		),
 	}, {
 		.chip_ids = ADRENO_CHIP_IDS(0x06010200),
diff --git a/drivers/pmdomain/qcom/rpmpd.c b/drivers/pmdomain/qcom/rpmpd.c
index 5f55fc791..a5b2a902a 100644
--- a/drivers/pmdomain/qcom/rpmpd.c
+++ b/drivers/pmdomain/qcom/rpmpd.c
@@ -877,7 +877,7 @@ static struct rpmpd *sm6115_rpmpds[] = {
 static const struct rpmpd_desc sm6115_desc = {
 	.rpmpds = sm6115_rpmpds,
 	.num_pds = ARRAY_SIZE(sm6115_rpmpds),
-	.max_state = RPM_SMD_LEVEL_TURBO_NO_CPR,
+	.max_state = RPM_SMD_LEVEL_BINNING,
 };
 
 static struct rpmpd *sm6125_rpmpds[] = {
