From 35834e09d3ff93d0339e8835b03d21099bbc7fd9 Mon Sep 17 00:00:00 2001
From: duolinux kernel port <port@localhost>
Date: Sat, 31 Oct 2026 10:58:46 -0600
Subject: [PATCH 19/79] rk:
 0020-input-pwm-vibra-support-minimum-duty-cycle.patch

---
 drivers/input/misc/pwm-vibra.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/input/misc/pwm-vibra.c b/drivers/input/misc/pwm-vibra.c
index 3e5ed685e..612010d8c 100644
--- a/drivers/input/misc/pwm-vibra.c
+++ b/drivers/input/misc/pwm-vibra.c
@@ -14,6 +14,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/input.h>
 #include <linux/kernel.h>
+#include <linux/math64.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -32,6 +33,7 @@ struct pwm_vibrator {
 	struct work_struct play_work;
 	u16 level;
 	u32 direction_duty_cycle;
+	u32 min_duty_cycle;
 	bool vcc_on;
 };
 
@@ -53,7 +55,12 @@ static int pwm_vibrator_start(struct pwm_vibrator *vibrator)
 	gpiod_set_value_cansleep(vibrator->enable_gpio, 1);
 
 	pwm_get_state(vibrator->pwm, &state);
-	pwm_set_relative_duty_cycle(&state, vibrator->level, 0xffff);
+	if (vibrator->min_duty_cycle && state.period > vibrator->min_duty_cycle)
+		state.duty_cycle = vibrator->min_duty_cycle +
+			div_u64((state.period - vibrator->min_duty_cycle) *
+				vibrator->level, 0xffff);
+	else
+		pwm_set_relative_duty_cycle(&state, vibrator->level, 0xffff);
 	state.enabled = true;
 
 	err = pwm_apply_might_sleep(vibrator->pwm, &state);
@@ -167,6 +174,9 @@ static int pwm_vibrator_probe(struct platform_device *pdev)
 		return err;
 	}
 
+	device_property_read_u32(&pdev->dev, "min-duty-cycle-ns",
+				 &vibrator->min_duty_cycle);
+
 	vibrator->pwm_dir = devm_pwm_get(&pdev->dev, "direction");
 	err = PTR_ERR_OR_ZERO(vibrator->pwm_dir);
 	switch (err) {
-- 
