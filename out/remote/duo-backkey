#!/usr/bin/env python3
"""Duo pad daemon.

Three things that InputPlumber cannot do for this device:

  * Back button (KEY_F1 on its virtual keyboard) toggles the on-screen keyboard.
  * Home button (KEY_HOME) runs a configurable action.
  * Right stick scrolling. InputPlumber's wheel buttons are declared but
    translate to an empty event list, and its profile format has no wheel-axis
    target, so the stick is left unmapped and the wheel events are generated
    here instead.

Scrolling is emitted per input event rather than on a timer: InputPlumber's
smooth left-stick motion comes from reacting to every event as it arrives, so a
polling loop would always feel late by comparison. Amounts are sent as hi-res
wheel deltas (120 units per notch), accumulated so partial ticks are not lost.

Two hardware quirks handled here:

  * InputPlumber hides the physical pad's nodes (devices get recreated by
    duo-pad-node.service) and grabs them intermittently, so the axis source is
    whichever device is currently delivering events rather than a fixed one.
  * Axis ranges differ per device: the pad reports +/-850, the virtual DualSense
    0..255 centred at 127. The range is queried per device with EVIOCGABS.
"""
import fcntl
import json
import os
import select
import struct
import subprocess
import sys
import time

EV_KEY = 0x01
EV_ABS = 0x03
KEY_F1 = 59
KEY_HOME = 102
ABS_RX = 3
ABS_RY = 4

DEBOUNCE = 0.4
SCROLL_DEADZONE = 0.12
SCROLL_MAX_HI_RES_PER_SEC = 2400   # 20 notches/second at full deflection
HI_RES_STEP = 120
TICK = 0.005

PAD = "Retroid Pocket Duo Lite Gamepad"
DUALSENSE = "Sony Interactive Entertainment DualSense Wireless Controller"
WATCHED = (
    "InputPlumber Keyboard",
    "duo-on-screen keyboard",
    PAD,
    DUALSENSE,
)

CONFIG = "/etc/duo/controller.json"
SCROLL_DIRECTION = "/etc/duo/scroll-direction"
SCROLL_SOURCE = "/etc/duo/scroll-source"

_mouse = None
_meta = None
_direction_cache: tuple[float, bool] = (0.0, True)
_source_cache: tuple[float, bool] = (0.0, True)


def scroll_enabled() -> bool:
    """False when InputPlumber owns scrolling (its patched build supports it)."""
    global _source_cache
    now = time.time()
    cached_time, cached_value = _source_cache
    if now - cached_time < 5.0:
        return cached_value
    value = True
    try:
        with open(SCROLL_SOURCE) as handle:
            text = handle.read().strip().lower()
        value = text not in ("inputplumber", "wheel")
    except OSError:
        pass
    _source_cache = (now, value)
    return value


def natural_scroll() -> bool:
    """True when pushing the stick up scrolls up (the default).

    Cached for a second: this is consulted on every emitted wheel tick, and a
    stat per tick was measurably expensive.
    """
    global _direction_cache
    now = time.time()
    cached_time, cached_value = _direction_cache
    if now - cached_time < 1.0:
        return cached_value
    value = True
    try:
        with open(SCROLL_DIRECTION) as handle:
            value = handle.read().strip().lower() not in ("standard", "inverted", "off")
    except OSError:
        pass
    _direction_cache = (now, value)
    return value


def eviocgabs(code: int) -> int:
    return (2 << 30) | (24 << 16) | (0x40 + code) | (ord("E") << 8)


def axis_range(fd: int, code: int) -> tuple[float, float]:
    buf = bytearray(24)
    try:
        fcntl.ioctl(fd, eviocgabs(code), buf)
    except OSError:
        return 0.0, 1.0
    _value, minimum, maximum, *_rest = struct.unpack("6i", bytes(buf))
    centre = (minimum + maximum) / 2.0
    half = (maximum - minimum) / 2.0
    return centre, (half if half else 1.0)


def device_paths() -> dict[str, str]:
    found: dict[str, str] = {}
    name = None
    for line in open("/proc/bus/input/devices"):
        line = line.strip()
        if line.startswith("N: Name="):
            name = line.split("=", 1)[1].strip().strip('"')
        elif line.startswith("H: Handlers=") and name in WATCHED:
            for handler in line.split("=", 1)[1].split():
                if handler.startswith("event"):
                    found[f"/dev/input/{handler}"] = name
                    break
    return found


def session_env() -> dict:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    env.setdefault("WAYLAND_DISPLAY", "wayland-0")
    return env


def toggle_keyboard() -> None:
    subprocess.Popen(["/usr/local/bin/duo-osk", "toggle"], env=session_env(),
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def home_action() -> str:
    try:
        with open(CONFIG) as handle:
            return json.load(handle).get("home", "launcher")
    except (OSError, ValueError):
        return "launcher"


def press_super() -> None:
    """Plasma binds the application launcher to the Meta key alone."""
    global _meta
    try:
        import uinput
    except ImportError:
        return
    if _meta is None:
        _meta = uinput.Device([uinput.KEY_LEFTMETA], name="duo-home-key")
    _meta.emit_click(uinput.KEY_LEFTMETA)


def handle_home() -> None:
    action = home_action()
    # Wake the display first: after the screen blanks, the Home button is the
    # natural "wake and go home" gesture on a handheld.
    subprocess.run(["kscreen-doctor", "--dpms", "on"], env=session_env(),
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   check=False)
    if action == "launcher":
        press_super()
    elif action == "keyboard":
        toggle_keyboard()


def wheel_hi_res(vertical: bool, hi_res: int) -> None:
    global _mouse
    if hi_res == 0:
        return
    try:
        import uinput
    except ImportError:
        return
    if _mouse is None:
        try:
            _mouse = uinput.Device(
                [uinput.REL_WHEEL, uinput.REL_HWHEEL,
                 uinput.REL_WHEEL_HI_RES, uinput.REL_HWHEEL_HI_RES],
                name="duo-scroll")
        except Exception as exc:            # noqa: BLE001
            print(f"duo-backkey: wheel device unavailable: {exc}", flush=True)
            return
    if vertical:
        _mouse.emit(uinput.REL_WHEEL_HI_RES, hi_res, syn=False)
        _mouse.emit(uinput.REL_WHEEL, int(hi_res / HI_RES_STEP), syn=False)
    else:
        _mouse.emit(uinput.REL_HWHEEL_HI_RES, hi_res, syn=False)
        _mouse.emit(uinput.REL_HWHEEL, int(hi_res / HI_RES_STEP), syn=False)
    _mouse.syn()


def main() -> int:
    # Refuse to run a second copy: two watchers each toggle on the same key
    # press, which cancels itself out and looks like the button doing nothing.
    import fcntl
    lock = open(f"/run/user/{os.getuid()}/duo-backkey.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("duo-backkey: another instance is already running", flush=True)
        return 0

    handles: dict[str, int] = {}
    names: dict[str, str] = {}
    ranges: dict[str, tuple[float, float, float, float]] = {}
    sticks: dict[str, list[int | None]] = {}
    last_abs: dict[str, float] = {}
    f1_down = False
    home_down = False
    active_source = None

    state = {"emit": time.time(), "v": 0.0, "h": 0.0}

    def emit_scroll(path: str) -> None:
        """Turn the current stick deflection into wheel motion at a fixed rate.

        Emission is on a timer (125 Hz) rather than per input event: the pad's
        events arrive irregularly, and emitting straight from them made the
        scroll visibly stutter even though the total amount was right.
        """
        cx, hx, cy, hy = ranges[path]
        raw_x, raw_y = sticks[path]
        vertical = 0.0 if raw_y is None else (raw_y - cy) / hy
        horizontal = 0.0 if raw_x is None else (raw_x - cx) / hx
        vertical = max(-1.0, min(1.0, vertical))
        horizontal = max(-1.0, min(1.0, horizontal))
        if not natural_scroll():
            vertical = -vertical

        now = time.time()
        dt = min(max(now - state["emit"], 0.002), 0.05)

        def rate(value: float) -> float:
            magnitude = (abs(value) - SCROLL_DEADZONE) / (1.0 - SCROLL_DEADZONE)
            if magnitude <= 0.0:
                return 0.0
            return (magnitude ** 1.15) * SCROLL_MAX_HI_RES_PER_SEC * dt

        step_v = rate(vertical) * (-1.0 if vertical > 0 else 1.0)
        step_h = rate(horizontal) * (1.0 if horizontal > 0 else -1.0)
        if not step_v and not step_h:
            return
        state["emit"] = now

        if step_v:
            state["v"] += step_v
            whole = int(state["v"])
            if whole:
                state["v"] -= whole
                wheel_hi_res(True, whole)
        if step_h:
            state["h"] += step_h
            whole = int(state["h"])
            if whole:
                state["h"] -= whole
                wheel_hi_res(False, whole)

    next_scan = 0.0
    while True:
        # Rescan the device list every two seconds instead of on every pass:
        # parsing /proc/bus/input/devices 200 times a second was the single
        # biggest cost in this daemon (28% of a core).
        now = time.time()
        if now >= next_scan:
            next_scan = now + 2.0
            for path, name in device_paths().items():
                if path in handles:
                    continue
                try:
                    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                except OSError:
                    continue
                handles[path] = fd
                names[path] = name
                cx, hx = axis_range(fd, ABS_RX)
                cy, hy = axis_range(fd, ABS_RY)
                ranges[path] = (cx, hx, cy, hy)
                sticks[path] = [None, None]
                print(f"duo-backkey: listening on {name} ({path}) "
                      f"x={cx:.0f}+-{hx:.0f} y={cy:.0f}+-{hy:.0f}", flush=True)

        if not handles:
            time.sleep(1.0)
            continue

        # Block until an event arrives or the tick expires - no busy polling.
        try:
            readable, _, _ = select.select(list(handles.values()), [], [], TICK)
        except InterruptedError:
            readable = []

        for fd in readable:
            path = next(p for p, h in handles.items() if h == fd)
            try:
                data = os.read(fd, 24 * 128)
            except BlockingIOError:
                continue
            except OSError:
                os.close(fd)
                del handles[path]
                continue
            for offset in range(0, len(data) - 23, 24):
                _s, _u, kind, code, value = struct.unpack(
                    "@llHHi", data[offset:offset + 24])
                if kind == EV_ABS:
                    if code == ABS_RY:
                        sticks[path][1] = value
                    elif code == ABS_RX:
                        sticks[path][0] = value
                    else:
                        continue
                    last_abs[path] = time.time()
                    active_source = path
                elif kind == EV_KEY and code in (KEY_F1, KEY_HOME):
                    # Act on the press *edge* only. A held button generates key
                    # repeats, and a time-based debounce let the first repeat
                    # after the window toggle again (keyboard appears, then
                    # vanishes a moment later).
                    if value == 0:
                        if code == KEY_F1:
                            f1_down = False
                        else:
                            home_down = False
                        continue
                    if code == KEY_F1:
                        if f1_down:
                            continue
                        f1_down = True
                        toggle_keyboard()
                    else:
                        if home_down:
                            continue
                        home_down = True
                        handle_home()

        # Scrolling is handled by InputPlumber when /etc/duo/scroll-source says
        # so (its patched build supports axis -> wheel natively). The daemon then
        # only handles the back and Home buttons.
        if scroll_enabled() and active_source and now - last_abs.get(active_source, 0) < 3.0:
            emit_scroll(active_source)


if __name__ == "__main__":
    sys.exit(main())
