#!/usr/bin/env python3
"""Record raw key events from every input device so we can see what each
physical button actually emits on Plasma. Writes to /tmp/button-capture.log."""
import glob
import os
import select
import struct
import time

KEY_NAMES = {}
try:
    import re
    for line in open("/usr/include/linux/input-event-codes.h"):
        m = re.match(r"#define\s+(KEY_[A-Z0-9_]+|BTN_[A-Z0-9_]+)\s+(\d+)", line)
        if m:
            KEY_NAMES[int(m.group(2))] = m.group(1)
except OSError:
    pass

DEVICE_NAMES = {}
name = None
for line in open("/proc/bus/input/devices"):
    line = line.strip()
    if line.startswith("N: Name="):
        name = line.split("=", 1)[1].strip().strip('"')
    elif line.startswith("H: Handlers="):
        for handler in line.split("=", 1)[1].split():
            if handler.startswith("event"):
                DEVICE_NAMES[f"/dev/input/{handler}"] = name

SKIP = ("Touchscreen", "Touchpad", "Motion Sensors", "duo-on-screen",
        "Headset Jack", "haptics", "pwrkey", "resin")

devices = {}
for path in sorted(DEVICE_NAMES):
    if any(s in DEVICE_NAMES[path] for s in SKIP):
        continue
    try:
        devices[path] = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        continue

deadline = time.time() + 120
print(f"capture: {len(devices)} devices, 120 s", flush=True)
with open("/tmp/button-capture.log", "a") as out:
    out.write(f"\n=== capture started {time.strftime('%H:%M:%S')}\n")
    while time.time() < deadline:
        readable, _, _ = select.select(list(devices.values()), [], [], 0.5)
        for fd in readable:
            path = next(p for p, f in devices.items() if f == fd)
            try:
                data = os.read(fd, 24 * 64)
            except OSError:
                continue
            for offset in range(0, len(data) - 23, 24):
                _s, _u, kind, code, value = struct.unpack(
                    "@llHHi", data[offset:offset + 24])
                if kind != 1 or value == 2:      # key events, skip repeat
                    continue
                label = KEY_NAMES.get(code, str(code))
                line = (f"{time.strftime('%H:%M:%S')} "
                        f"{DEVICE_NAMES[path][:34]:34} {label:14} "
                        f"{'press' if value else 'release'}")
                out.write(line + "\n")
                out.flush()
                print(line, flush=True)
    out.write("=== capture ended\n")
