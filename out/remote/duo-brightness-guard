#!/usr/bin/env python3
"""Backlight policy for the two-panel handheld.

Deliberately touches *only* sysfs. An earlier version also policed DP-1 by
reading kscreen-doctor, but that value always reports 0% on this panel even when
the backlight is at 128, so the guard re-issued config changes every 10 seconds.
Repeated kscreen config attempts are what killed the display (a rejected modeset
leaves KWin without scanout), so that path is gone for good.

What it does:
  * pins the bottom panel's backlight (serial0-0) at full, because the built-in
    screen's slider writes both backlight devices
  * keeps the built-in screen (backlight) above a readable floor
"""
import pathlib
import time

FLOOR_PERCENT = 12
POLL = 2.0
BOTTOM = "serial0-0"
TOP = "backlight"


def read_int(path: pathlib.Path) -> int | None:
    try:
        return int(path.read_text())
    except (OSError, ValueError):
        return None


def pin_bottom() -> None:
    maximum = read_int(pathlib.Path(f"/sys/class/backlight/{BOTTOM}/max_brightness"))
    current = read_int(pathlib.Path(f"/sys/class/backlight/{BOTTOM}/brightness"))
    if maximum is None or current is None:
        return
    if current != maximum:
        try:
            pathlib.Path(f"/sys/class/backlight/{BOTTOM}/brightness").write_text(str(maximum))
        except OSError:
            pass


def clamp_top() -> None:
    maximum = read_int(pathlib.Path(f"/sys/class/backlight/{TOP}/max_brightness"))
    current = read_int(pathlib.Path(f"/sys/class/backlight/{TOP}/brightness"))
    if maximum is None or current is None:
        return
    floor = max(1, maximum * FLOOR_PERCENT // 100)
    if current < floor:
        try:
            pathlib.Path(f"/sys/class/backlight/{TOP}/brightness").write_text(str(floor))
            print(f"brightness-guard: top {current} -> {floor}", flush=True)
        except OSError:
            pass


def main() -> None:
    while True:
        pin_bottom()
        clamp_top()
        time.sleep(POLL)


if __name__ == "__main__":
    main()
