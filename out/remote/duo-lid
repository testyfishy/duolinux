#!/usr/bin/env python3
"""Suspend when the lid is genuinely closed.

PowerDevil takes the handle-lid-switch inhibitor and its own lid action was
unset, so KDE's default suspended the machine on any lid event - including a
bounce while the lid was open and the device was on the charger. PowerDevil's
lid action is now "do nothing" for every profile, and this daemon is the only
thing that suspends.

A close must stay closed for CLOSE_DWELL seconds and still read as closed from
the switch itself before anything happens, so a single glitchy event cannot put
the device to sleep. Opening the lid always wakes the machine and restores both
panels, which is why the daemon blanks them before suspending: suspend blanks
DSI-1 but the DP-1 panel behind the bridge stays lit and the device looks
half-awake.
"""
import fcntl
import os
import select
import struct
import subprocess
import time

EV_SW = 0x05
SW_LID = 0x00
EVIOCGSW = 0x8008451B  # _IOC(READ, 'E', 0x1b, 8)

DEVICE = "gpio-keys-lid"
TICK = 0.25
CLOSE_DWELL = 2.0


def find_device() -> str | None:
    name = None
    for line in open("/proc/bus/input/devices"):
        line = line.strip()
        if line.startswith("N: Name="):
            name = line.split("=", 1)[1].strip().strip('"')
        elif line.startswith("H: Handlers=") and name == DEVICE:
            for handler in line.split("=", 1)[1].split():
                if handler.startswith("event"):
                    return f"/dev/input/{handler}"
    return None


def switch_closed(fd: int) -> int:
    """Current SW_LID: 1 closed, 0 open, -1 unknown."""
    buffer = bytearray(8)
    try:
        fcntl.ioctl(fd, EVIOCGSW, buffer, True)
    except OSError:
        return -1
    return int.from_bytes(buffer, "little") & 1


def blank(write: bool) -> None:
    if write:
        subprocess.run(["systemctl", "stop", "duo-brightness-guard"], check=False)
        for device in ("backlight", "serial0-0"):
            try:
                with open(f"/sys/class/backlight/{device}/brightness", "w") as handle:
                    handle.write("0")
            except OSError:
                pass
    else:
        for device, level in (("backlight", "150"), ("serial0-0", "255")):
            try:
                with open(f"/sys/class/backlight/{device}/brightness", "w") as handle:
                    handle.write(level)
            except OSError:
                pass
        subprocess.run(["systemctl", "start", "duo-brightness-guard"], check=False)


def main() -> int:
    fd = None
    pending_close = None

    while True:
        if fd is None:
            path = find_device()
            if path is None:
                time.sleep(2)
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                print(f"duo-lid: watching {path} "
                      f"(switch reports {'closed' if switch_closed(fd) else 'open'})",
                      flush=True)
            except OSError:
                time.sleep(2)
                continue

        try:
            readable, _, _ = select.select([fd], [], [], TICK)
        except InterruptedError:
            readable = []

        if readable:
            try:
                data = os.read(fd, 24 * 32)
            except OSError:
                os.close(fd)
                fd = None
                continue
            for offset in range(0, len(data) - 23, 24):
                _s, _u, kind, code, value = struct.unpack(
                    "@llHHi", data[offset:offset + 24])
                if kind != EV_SW or code != SW_LID:
                    continue
                if value:
                    pending_close = time.time()
                    print("duo-lid: lid closed, waiting before suspending", flush=True)
                else:
                    if pending_close is not None:
                        print("duo-lid: lid reopened, canceling suspend", flush=True)
                    pending_close = None
                    blank(False)

        if pending_close is not None and time.time() - pending_close >= CLOSE_DWELL:
            pending_close = None
            state = switch_closed(fd)
            if state != 1:
                print(f"duo-lid: close ignored, switch now reports state {state}",
                      flush=True)
                blank(False)
                continue
            print("duo-lid: lid still closed, suspending", flush=True)
            blank(True)
            subprocess.run(["systemctl", "suspend"], check=False)


if __name__ == "__main__":
    raise SystemExit(main())
