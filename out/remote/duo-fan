#!/usr/bin/env python3
"""Fan control for the Duo Lite: quiet by default, data-driven, never hunting.

Why these numbers: the kernel's own trip points say this SoC (SM6125) begins
passive throttling at 95 C and only treats 115 C as critical. Anything below
that is a comfort question, not a safety question, so the default profile keeps
the fan off for as long as possible and barely audible when it runs.

The control algorithm follows lm-sensors' fancontrol, the design that Steam
Deck's and Bazzite's handheld fan daemons are variations of:

  * AVERAGE       - average a window of samples; per-core spikes must not move it
  * interpolation - pwm varies smoothly between curve points, no cliffs
  * HYSTERESIS    - a move must beat the current target by a deadband
  * MINSTART      - short kick to break stiction when the fan starts
  * MINSTOP       - lowest pwm that keeps the fan turning
  * rate limit    - the pwm approaches its target gradually

Profiles: quiet (default), balanced, performance. Chosen in Settings.

Efficiency (2026-10): the loop used to poll every 2 s forever, log every poll
(~43k journal lines a day), write pwm1/pwm1_enable every tick even when
unchanged, and re-glob every thermal zone each time. Fixed here:

  * the average is a TIME window, so a slower poll cannot silently stretch it
    and change the control law;
  * polling adapts: 2 s while the fan runs or the hottest zone is within 10 C of
    the start point, 5 s otherwise - never slower, a burst can heat several
    degrees per second;
  * sysfs is written only when the value changes, but re-read every 45 s and
    re-asserted if something reset it (suspend/resume resets pwm1_enable);
  * the journal only sees a line when something meaningful changed, plus a
    15 minute heartbeat.

The control law lives in FanController.step(), a pure function of
(temperature, time, state), so it can be replayed against the old implementation
by toolkit/kernel/test-fan-replay.py.
"""
from __future__ import annotations

import glob
import os
import pathlib
import time
from collections import deque

POLL_FAST = 2.0          # fan running, or near the start threshold
POLL_SLOW = 5.0          # otherwise; never slower than this
WINDOW = 16.0            # seconds of samples averaged
HYSTERESIS = 2
NEAR_START = 10          # degrees below start that forces fast polling
HEARTBEAT = 900.0        # log at most this often when nothing changes
REASSERT = 45.0          # re-read the fan registers this often
ZONE_RESCAN = 60.0       # re-read the zone list at most this often

PROFILE_FILE = pathlib.Path("/etc/duo/fan-profile")

BASE = [(50, 0), (55, 45), (60, 80), (65, 110), (70, 140),
        (75, 175), (80, 210), (85, 255)]

PROFILES = {
    "quiet": dict(curve=[(50, 0), (55, 26), (65, 30), (70, 40),
                         (76, 70), (82, 100), (85, 110)],
                  start=55, stop=48,
                  minpwm=26, minstop=24, minstart=70,
                  step_up=3, step_down=2),
    "balanced": dict(offset=+4, cap=190, start=62, stop=52,
                     minpwm=55, minstop=40, minstart=200,
                     step_up=8, step_down=5),
    "performance": dict(offset=0, cap=255, start=55, stop=48,
                        minpwm=70, minstop=45, minstart=220,
                        step_up=12, step_down=8),
}


def log(msg: str) -> None:
    print(msg, flush=True)


def load_profile() -> tuple[list[tuple[int, int]], str, dict]:
    name = "quiet"
    try:
        name = PROFILE_FILE.read_text().strip() or "quiet"
    except OSError:
        pass
    if name not in PROFILES:
        name = "quiet"
    cfg = PROFILES[name]
    if cfg.get("curve"):
        curve = list(cfg["curve"])
    else:
        curve = [(max(30, temp + cfg["offset"]), min(pwm, cfg["cap"]))
                 for temp, pwm in BASE]
    return curve, name, cfg


def interpolate(temp_c: float, curve: list[tuple[int, int]]) -> int:
    if temp_c <= curve[0][0]:
        return curve[0][1]
    if temp_c >= curve[-1][0]:
        return curve[-1][1]
    for (t0, p0), (t1, p1) in zip(curve, curve[1:]):
        if t0 <= temp_c <= t1:
            ratio = (temp_c - t0) / (t1 - t0)
            return int(round(p0 + ratio * (p1 - p0)))
    return curve[-1][1]


class FanController:
    """The control law, free of IO so it can be replayed in tests."""

    def __init__(self, curve, cfg):
        self.curve = curve
        self.cfg = cfg
        self.samples: deque[tuple[float, int]] = deque()
        self.applied = 0
        self.target = 0
        self.running = False
        self.above = 0
        self.below = 0
        self.kick_until = 0.0
        self.started_at = None
        self.stopped_at = None

    def step(self, temp_mc: int, now: float) -> int:
        cfg = self.cfg
        self.samples.append((now, temp_mc))
        cutoff = now - WINDOW
        while self.samples and self.samples[0][0] < cutoff:
            self.samples.popleft()
        avg_c = int(sum(t for _, t in self.samples) / len(self.samples) / 1000.0)

        if avg_c >= cfg["start"]:
            self.above += 1
            self.below = 0
        elif avg_c <= cfg["stop"]:
            self.below += 1
            self.above = 0
        else:
            self.above = self.below = 0

        if not self.running and self.above >= 2:
            self.running = True
            self.kick_until = now + 1.0
            self.applied = cfg["minstart"]
            self.started_at = now
        elif self.running and self.below >= 10:
            self.running = False
            self.applied = 0
            self.stopped_at = now

        if self.running:
            wanted = max(cfg["minpwm"], interpolate(avg_c, self.curve))
            wanted = min(wanted, max(p for _, p in self.curve))
            if wanted > self.target + HYSTERESIS:
                self.target = wanted
            elif wanted < self.target - HYSTERESIS:
                self.target = wanted

            if now < self.kick_until:
                self.applied = cfg["minstart"]
            elif self.target > self.applied:
                self.applied = min(self.target, self.applied + cfg["step_up"])
            elif self.target < self.applied:
                self.applied = max(self.target, self.applied - cfg["step_down"])
            self.applied = max(self.applied, cfg["minstop"])
        else:
            self.applied = 0
            self.target = 0

        self.avg_c = avg_c
        return self.applied


class Zones:
    """Thermal zones with open fds; re-read with pread instead of open/close."""

    def __init__(self):
        self.fds: list[int] = []
        self.last_scan = 0.0

    def scan_if_needed(self, now: float, force: bool = False) -> None:
        if not force and now - self.last_scan < ZONE_RESCAN and self.fds:
            return
        self.last_scan = now
        for fd in self.fds:
            try:
                os.close(fd)
            except OSError:
                pass
        self.fds = []
        for zone in glob.glob("/sys/class/thermal/thermal_zone*"):
            p = pathlib.Path(zone)
            try:
                name = (p / "type").read_text().strip()
            except OSError:
                continue
            if not (name.startswith("cpuss") or name.startswith("cpu-")
                    or name.startswith("gpu") or name.startswith("pm6125")):
                continue
            try:
                self.fds.append(os.open(p / "temp", os.O_RDONLY))
            except OSError:
                continue

    def hottest(self) -> int:
        best = 0
        for fd in self.fds:
            try:
                best = max(best, int(os.pread(fd, 16, 0).strip() or 0))
            except (OSError, ValueError):
                continue
        return best

    def close(self) -> None:
        for fd in self.fds:
            try:
                os.close(fd)
            except OSError:
                pass
        self.fds = []


def find_fan() -> pathlib.Path | None:
    for hwmon in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            if pathlib.Path(hwmon, "name").read_text().strip() == "pwmfan":
                return pathlib.Path(hwmon)
        except OSError:
            continue
    return None


def claim_fan() -> None:
    claimed = []
    for zone in glob.glob("/sys/class/thermal/thermal_zone*"):
        drives_fan = False
        for cdev in pathlib.Path(zone).glob("cdev*"):
            try:
                if (cdev / "type").read_text().strip() == "pwm-fan":
                    drives_fan = True
                    break
            except OSError:
                continue
        if not drives_fan:
            continue
        try:
            pathlib.Path(zone, "policy").write_text("user_space")
            claimed.append(pathlib.Path(zone, "type").read_text().strip())
        except OSError:
            pass
    if claimed:
        log(f"fan: claimed from governor: {', '.join(claimed)}")


class Pwm:
    def __init__(self, fan: pathlib.Path):
        self.fan = fan
        self.value = None
        self.enabled = False
        self.last_check = 0.0

    def write(self, value: int, now: float) -> bool:
        value = max(0, min(255, value))
        try:
            # Re-assert: resume from suspend can reset pwm1_enable behind us.
            if not self.enabled or now - self.last_check >= REASSERT:
                self.last_check = now
                try:
                    if int((self.fan / "pwm1_enable").read_text().strip()) != 1:
                        (self.fan / "pwm1_enable").write_text("1")
                    if self.value is not None and \
                       int((self.fan / "pwm1").read_text().strip()) != self.value:
                        (self.fan / "pwm1").write_text(str(self.value))
                except (OSError, ValueError):
                    self.enabled = False
            if not self.enabled:
                (self.fan / "pwm1_enable").write_text("1")
                self.enabled = True
            if value != self.value:
                (self.fan / "pwm1").write_text(str(value))
                self.value = value
            return True
        except OSError:
            self.enabled = False
            return False


def main() -> None:
    claim_fan()
    curve, profile, cfg = load_profile()
    log(f"fan: profile {profile} start {cfg['start']}C stop {cfg['stop']}C "
        f"max {max(p for _, p in curve)}")

    ctrl = FanController(curve, cfg)
    zones = Zones()
    zones.scan_if_needed(time.monotonic(), force=True)
    pwm: Pwm | None = None
    last_log = 0.0
    last_log_state = None
    last_log_pwm = -1

    while True:
        now = time.monotonic()

        if pwm is None or not (pwm.fan / "pwm1").exists():
            fan = find_fan()
            ctrl = FanController(curve, cfg)
            if fan is None:
                pwm = None
                time.sleep(5)
                continue
            pwm = Pwm(fan)
            pwm.write(0, now)

        zones.scan_if_needed(now)
        temp = zones.hottest()
        applied = ctrl.step(temp, now)
        temp_c = temp // 1000

        if not pwm.write(applied, now):
            pwm = None
            continue

        changed = (ctrl.running != last_log_state) or abs(applied - last_log_pwm) >= 4
        if changed or now - last_log >= HEARTBEAT:
            log(f"fan: avg {ctrl.avg_c}C now {temp_c}C target {ctrl.target} "
                f"pwm {applied} {'on' if ctrl.running else 'off'} [{profile}]")
            last_log = now
            last_log_state = ctrl.running
            last_log_pwm = applied

        # Fast while running or close to the start point; a burst can heat this
        # SoC by several degrees a second, so never slower than POLL_SLOW.
        if ctrl.running or temp_c >= cfg["start"] - NEAR_START:
            delay = POLL_FAST
        else:
            delay = POLL_SLOW
        time.sleep(delay)


if __name__ == "__main__":
    main()
