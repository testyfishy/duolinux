#!/bin/sh
# On-screen keyboard, bound to the BOTTOM panel by output name.
#
# This uses a patched wvkbd (v0.15 + --output) so the layer surface is created
# on DP-1 explicitly. It no longer relies on which output happens to be focused,
# so the keyboard can never appear on the top screen.
BOTTOM=DP-1
STATE=/run/user/$(id -u)/duo-osk.on

CONF="$HOME/.config/duo/kbd-height"

# The keyboard height must follow the bottom panel's LOGICAL height, because the
# output scale changes with the layout (DP-1 is 1280x960 at scale 1.75 today,
# i.e. 549 logical px). A hardcoded height then overflows onto the top panel.
logical_height() {
    kscreen-doctor -j 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for o in d.get("outputs", []):
    if o.get("name") == "DP-1":
        scale = o.get("scale") or 1
        print(int(o["size"]["height"] / scale))
        break
'
}

LH=$(logical_height)
case "$LH" in ''|*[!0-9]*) LH=549 ;; esac

# 70% of the panel by default (the owner wants a large, thumb-friendly keyboard;
# this device has no hardware keyboard at all). A saved preference is honoured
# only when it actually fits; if it does not (a stale height from a different
# scale), fall back to the fraction rather than pinning it to full height.
H=$((LH * 70 / 100))
if [ -f "$CONF" ]; then
    want=$(cat "$CONF" 2>/dev/null)
    case "$want" in
        ''|*[!0-9]*) : ;;
        *) [ "$want" -le "$((LH - 24))" ] && H=$want ;;
    esac
fi
[ "$H" -lt 120 ] && H=120
[ "$H" -gt "$((LH - 24))" ] && H=$((LH - 24))

start_hidden() {
    wvkbd-mobintl \
        --output "$BOTTOM" \
        -H "$H" -L "$H" -R 10 \
        --fn "DejaVu Sans 22" \
        --alpha 255 \
        --bg 141417 \
        --fg 2c2c2e \
        --fg-sp 3a3a3c \
        --press 0a84ff \
        --press-sp 0a84ff \
        --text ffffff \
        --text-sp 9a9aa0 \
        --landscape-layers full,landscape,special,landscapespecial \
        --hidden \
        >/dev/null 2>&1 &
    sleep 1
}

case "${1:-toggle}" in
    --init)
        pgrep -x wvkbd-mobintl >/dev/null 2>&1 || start_hidden
        rm -f "$STATE"
        ;;
    restart)
        pkill -x wvkbd-mobintl 2>/dev/null
        sleep 1
        rm -f "$STATE"
        start_hidden
        ;;
    show)
        pgrep -x wvkbd-mobintl >/dev/null 2>&1 || start_hidden
        pkill -USR2 -x wvkbd-mobintl
        touch "$STATE"
        ;;
    hide)
        pkill -USR1 -x wvkbd-mobintl
        rm -f "$STATE"
        ;;
    *)
        if [ -f "$STATE" ]; then
            pkill -USR1 -x wvkbd-mobintl
            rm -f "$STATE"
        else
            pgrep -x wvkbd-mobintl >/dev/null 2>&1 || start_hidden
            pkill -USR2 -x wvkbd-mobintl
            touch "$STATE"
        fi
        ;;
esac
